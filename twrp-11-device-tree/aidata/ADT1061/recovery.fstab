# mount point    fstype    device                                                              flags
/boot            emmc      /dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/boot       flags=display="Boot";backup=1;flashimg=1
/recovery        emmc      /dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/recovery   flags=display="Recovery";backup=1;flashimg=1
/dtbo            emmc      /dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/dtbo       flags=display="DTBO";backup=1;flashimg=1
/vbmeta          emmc      /dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/vbmeta     flags=display="VBMeta";backup=1;flashimg=1

# logical
/system_root     ext4      system                                                              flags=display="System";logical;first_stage_mount
/vendor          ext4      vendor                                                              flags=display="Vendor";logical;first_stage_mount
/product         ext4      product                                                             flags=display="Product";logical;first_stage_mount

# userdata
/data            f2fs      /dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/userdata   flags=display="Data"
/cache           ext4      /dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/cache      flags=display="Cache"
/persist         ext4      /dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/persist    flags=display="Persist";backup=1

# imei vb
/misc            emmc      /dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/misc       flags=display="Misc";backup=1
/logo            emmc      /dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/logo       flags=display="Logo";backup=1;flashimg=1
/socko           ext4      /dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/socko      flags=display="Socko";backup=1
/odmko           ext4      /dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/odmko      flags=display="Odmko";backup=1

# external
/external_sd     vfat      /dev/block/mmcblk1p1                                                flags=display="MicroSD";storage;wipeui;removable
/usb_otg         vfat      /dev/block/sda1 /dev/block/sda                                      flags=display="USB-OTG";storage;wipeui;removable
